/* FlutterCraft v0.2.0 — Base Textual CSS
   Hardcoded Tokyo Night palette — full theme variables in Step 1.13.
*/

/* ── Screen ──────────────────────────────────────────────────── */
Screen {
    layout: vertical;
    background: #1a1b26;
}

/* ── Main area ───────────────────────────────────────────────── */
#main-area {
    height: 1fr;
    padding: 1 1 0 1;
}

/* SidebarPanel owns its own CSS via DEFAULT_CSS */

/* ── Content area ────────────────────────────────────────────── */
#content-area {
    width: 1fr;
    layout: vertical;
}

#content-panel {
    height: 1fr;
    background: #1f2335;
    border: round #3b4261;
    border-title-color: #7aa2f7;
    border-title-align: left;
    content-align: center middle;
    padding: 1 3;
    margin-bottom: 1;
}

/* OutputPanel owns its own CSS via DEFAULT_CSS */

/* ── Command input ────────────────────────────────────────────── */
#command-input {
    margin: 0 1 0 1;
}

/* Footer uses FlutterCraftFooter.DEFAULT_CSS */
